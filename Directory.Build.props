<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- eng/package.sh stamps releases from their vX.Y.Z tag; only those self-update. -->
    <Version>0.0.0-dev</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Release targets (eng/package.sh); listed so RID-specific publishes keep the lock files stable. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <!-- Windows releases are single-file: flag single-file hazards in every build (this also keeps
         the analyzer's ILLink package in the lock files for normal and publish restores alike). -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <!-- Developer builds use the self-contained native libraries of the linux-package / windows-package
       CMake preset once it has been built (BUILDING.md); eng/package.sh passes the directory explicitly. -->
  <PropertyGroup Condition="'$(WaddamburoNativeDir)' == ''">
    <WaddamburoPackageNativeDir Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)out/build/native/win-x64/windows-package/stage/Release/bin</WaddamburoPackageNativeDir>
    <WaddamburoPackageNativeDir Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)out/build/native/linux-x64/linux-package/stage/Release/lib</WaddamburoPackageNativeDir>
    <WaddamburoNativeDir Condition="Exists('$(WaddamburoPackageNativeDir)')">$(WaddamburoPackageNativeDir)</WaddamburoNativeDir>
  </PropertyGroup>
  <!-- Releases use the JIT, but the game must stay NativeAOT-compatible (consoles and other targets
       without a JIT): trim/AOT analyzers run on every product project. -->
  <PropertyGroup Condition="$([MSBuild]::MakeRelative($(MSBuildThisFileDirectory), $(MSBuildProjectDirectory)).StartsWith('src'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
