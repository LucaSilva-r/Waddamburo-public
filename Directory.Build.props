<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- eng/package.sh stamps releases from their vX.Y.Z tag; only those self-update. -->
    <Version>0.0.0-dev</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Release targets (eng/package.sh); listed so RID-specific publishes keep the lock files stable. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <!-- Windows releases are single-file: flag single-file hazards in every build (this also keeps
         the analyzer's ILLink package in the lock files for normal and publish restores alike). -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <!-- Releases use the JIT, but the game must stay NativeAOT-compatible (consoles and other targets
       without a JIT): trim/AOT analyzers run on every product project. The osu!lazer reader is excluded,
       its ppy.osu.Game dependency is not AOT-safe and the game does not ship it. -->
  <PropertyGroup Condition="$([MSBuild]::MakeRelative($(MSBuildThisFileDirectory), $(MSBuildProjectDirectory)).StartsWith('src'))
      and '$(MSBuildProjectName)' != 'Waddamburo.Providers.OsuLazer'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- ppy.osu.Game intentionally pins AutoMapper 13.0.1. The reported issue
         concerns configuration APIs Waddamburo never calls while reading Realm. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>
</Project>
