<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders/Compiled/*.*"
                      LogicalName="Waddamburo.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The bgfx renderer from the native build (native/bgfx) runs next to the executable. -->
  <PropertyGroup>
    <WaddamburoBgfxDir Condition="'$(WaddamburoBgfxDir)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)../../out/build/native/win-x64/windows-debug/bgfx/prefix/bin</WaddamburoBgfxDir>
    <WaddamburoBgfxDir Condition="'$(WaddamburoBgfxDir)' == ''">$(MSBuildThisFileDirectory)../../out/build/native/linux-x64/linux-debug/bgfx/prefix/lib</WaddamburoBgfxDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(WaddamburoBgfxDir)/bgfx*.dll;$(WaddamburoBgfxDir)/libbgfx*.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Waddamburo.Formats/Waddamburo.Formats.csproj" />
    <ProjectReference Include="../Waddamburo.Lumen/Waddamburo.Lumen.csproj" />
  </ItemGroup>

</Project>
