<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <ApplicationId>org.waddamburo.game</ApplicationId>
    <ApplicationTitle>Waddamburo</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version.Split('-')[0])</ApplicationDisplayVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The game references the desktop executable project (Waddamburo.App) as a library. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Self-contained APKs (adb install), not Fast Deployment's separately pushed assemblies. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <!-- CoreCLR, the one runtime the game runs on everywhere: on a Snapdragon 439 song select went from ~30 fps (Mono,
       fully AOT compiled) to about 50. Experimental on Android in .NET 10 (warning XA1040). -->
  <PropertyGroup>
    <UseMonoRuntime>false</UseMonoRuntime>
    <NoWarn>$(NoWarn);XA1040</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- partial: only the framework's assemblies are trimmed, the game's stay whole (Realm, JSON, SQLite reflect). -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Native libraries of the android-package CMake preset (native/CMakePresets.json). -->
  <PropertyGroup>
    <WaddamburoAndroidNativeDir Condition="'$(WaddamburoAndroidNativeDir)' == ''">$(MSBuildThisFileDirectory)../../out/build/native/android-arm64/android-package/stage/Release/lib</WaddamburoAndroidNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <AndroidNativeLibrary Include="$(WaddamburoAndroidNativeDir)/*.so" Abi="arm64-v8a" />
  </ItemGroup>
  <ItemGroup Condition="'$(WaddamburoAndroidNoticesDir)' != ''">
    <AndroidAsset Include="$(WaddamburoAndroidNoticesDir)/**/*"
                  LogicalName="licenses/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="WaddamburoAddRuntimeNotices" BeforeTargets="_ComputeAndroidAssetsPaths"
          DependsOnTargets="ResolveFrameworkReferences" Condition="'$(WaddamburoAndroidNoticesDir)' != ''">
    <ItemGroup>
      <AndroidAsset Include="@(ResolvedRuntimePack->'%(PackageDirectory)/LICENSE.TXT')"
                    LogicalName="licenses/dotnet/%(ResolvedRuntimePack.NuGetPackageId)/LICENSE.TXT" />
      <AndroidAsset Include="@(ResolvedRuntimePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')"
                    LogicalName="licenses/dotnet/%(ResolvedRuntimePack.NuGetPackageId)/THIRD-PARTY-NOTICES.TXT" />
    </ItemGroup>
  </Target>
  <Target Name="WaddamburoRequireAndroidNatives" BeforeTargets="Build">
    <Error Condition="!Exists('$(WaddamburoAndroidNativeDir)/libbgfx.so')"
           Text="Build the native libraries first: cd native &amp;&amp; cmake --preset android-package &amp;&amp; cmake --build --preset android-package" />
  </Target>

  <ItemGroup>
    <AndroidResource Include="../../eng/packaging/waddamburo.png" Link="Resources/drawable/icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Waddamburo.App/Waddamburo.App.csproj" />
  </ItemGroup>

</Project>
