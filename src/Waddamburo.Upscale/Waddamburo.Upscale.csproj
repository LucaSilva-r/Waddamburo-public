<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Always optimized: in a Debug build the vector code runs about ten times slower, which
         makes live texture upscaling crawl in development runs. -->
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Developer builds: the BC7 library from the native debug build runs next to the executable.
       Release publishes take it from WaddamburoNativeDir (Waddamburo.App). -->
  <PropertyGroup Condition="'$(WaddamburoNativeDir)' == ''">
    <WaddamburoTextureDir Condition="'$(WaddamburoTextureDir)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)../../out/build/native/win-x64/windows-debug/stage/Debug/bin</WaddamburoTextureDir>
    <WaddamburoTextureDir Condition="'$(WaddamburoTextureDir)' == ''">$(MSBuildThisFileDirectory)../../out/build/native/linux-x64/linux-debug/stage/Debug/lib</WaddamburoTextureDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(WaddamburoNativeDir)' == ''">
    <None Include="$(WaddamburoTextureDir)/waddamburo_texture*.dll;$(WaddamburoTextureDir)/libwaddamburo_texture*.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
