<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The Realm is read through its dynamic API: no model classes for Realm's Fody weaver. -->
    <DisableFody>true</DisableFody>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Realm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Waddamburo.Catalog/Waddamburo.Catalog.csproj" />
  </ItemGroup>
</Project>
