<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The Windows release starts without a console (config.cfg console = true opens one). -->
    <OutputType Condition="'$(PublishSingleFile)' == 'true' and '$(RuntimeIdentifier)' == 'win-x64'">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>../../eng/packaging/waddamburo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The self-contained native libraries from the linux-package / windows-package CMake presets
       run next to the executable (releases via eng/package.sh, developer builds via Directory.Build.props). -->
  <ItemGroup Condition="'$(WaddamburoNativeDir)' != ''">
    <None Include="$(WaddamburoNativeDir)/waddamburo_*.dll;$(WaddamburoNativeDir)/libwaddamburo_*.so;$(WaddamburoNativeDir)/bgfx*.dll;$(WaddamburoNativeDir)/libbgfx*.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Built-in folder art (patterns, emblems; osu/box.png is the osu! logo, unaltered per osu!'s brand guidelines). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/folders/**/*.png" />
  </ItemGroup>

  <!-- Texture upscaling model (Real-ESRGAN realesr-animevideov3, BSD-3-Clause), embedded: the Windows
       release is a single file. Its license text ships in licenses.zip (eng/package.sh). -->
  <ItemGroup>
    <EmbeddedResource Include="Upscale/realesr-animevideov3-x3.param;Upscale/realesr-animevideov3-x3.bin"
                      LogicalName="Waddamburo.Upscale.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- UI text per language (Strings.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="Languages/*.json" LogicalName="Waddamburo.Languages.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Waddamburo.Catalog/Waddamburo.Catalog.csproj" />
    <ProjectReference Include="../Waddamburo.Game/Waddamburo.Game.csproj" />
    <ProjectReference Include="../Waddamburo.Platform.Sdl/Waddamburo.Platform.Sdl.csproj" />
    <ProjectReference Include="../Waddamburo.Providers.OsuLazer/Waddamburo.Providers.OsuLazer.csproj" />
    <ProjectReference Include="../Waddamburo.Providers.Stock/Waddamburo.Providers.Stock.csproj" />
    <ProjectReference Include="../Waddamburo.Providers.Tja/Waddamburo.Providers.Tja.csproj" />
    <ProjectReference Include="../Waddamburo.Upscale/Waddamburo.Upscale.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- QR codes for the home setup's sign-in and friend codes (MIT). -->
    <PackageReference Include="QRCoder" />
  </ItemGroup>

</Project>
