{
  // A movie package: see docs/development/free-movies-plan.md. View it with
  //   dotnet run --project src/Waddamburo.App -- --package=samples/movie-package/bounce
  "format": 1,
  "frameRate": 60,
  "root": "main",
  "textures": { "ball": "textures/ball.png", "star": "textures/star.svg" },
  "shapes": {
    "ball": { "texture": "ball", "rect": [-32, -32, 64, 64] },
    "star": { "texture": "star", "rect": [-64, -64, 128, 128] }
  },
  // Text fields: a script sets their "text"; the engine draws it in the game's font.
  "texts": {
    "counter": { "rect": [0, 0, 300, 56], "size": 44, "align": "right", "color": "#ffe38a" }
  },
  "sprites": {
    // A clip of its own: the ball squashes when it lands. Its 60 frames loop while "main" moves it.
    "bouncer": {
      "frames": 60,
      "layers": [
        { "character": "ball",
          "keys": [
            { "frame": 0, "y": -300 },
            { "frame": 26, "y": 0 },
            { "frame": 30, "y": 12, "scaleX": 1.3, "scaleY": 0.7 },
            { "frame": 34, "y": 0 },
            { "frame": 59, "y": -295 }
          ] }
      ]
    },
    "main": {
      "frames": 240,
      // Scripts run when their frame is entered ("0", or a label's name).
      "scripts": { "in": "scripts/main.as" },
      "labels": { "in": 0, "across": 30, "out": 210 },
      "layers": [
        { "character": "bouncer", "name": "bouncer",
          "keys": [
            { "frame": 0, "x": 140, "y": 560, "alpha": 0 },
            { "frame": 30, "x": 140, "y": 560 },
            { "frame": 210, "x": 1140, "y": 560, "tint": [1, 0.6, 1] },
            { "frame": 239, "x": 1140, "y": 560, "alpha": 0 }
          ] },
        { "character": "ball", "name": "glow", "blend": "add", "until": 210,
          "keys": [
            { "frame": 30, "x": 640, "y": 200, "scale": 0, "alpha": 0 },
            { "frame": 120, "x": 640, "y": 200, "scale": 4, "alpha": 0.5 },
            { "frame": 209, "x": 640, "y": 200, "scale": 0, "alpha": 0 }
          ] },
        { "character": "counter", "name": "counter", "keys": [ { "frame": 0, "x": 940, "y": 640 } ] },
        { "character": "star", "name": "star",
          "keys": [
            { "frame": 0, "x": 1100, "y": 140, "rotation": 0 },
            { "frame": 239, "x": 1100, "y": 140, "rotation": 358.5 }
          ] }
      ]
    }
  }
}
