<Project>
  <!-- Injected with -p:CustomAfterMicrosoftCommonTargets: Waddamburo's native libraries bind statically on Switch.
       ImGui (editors) and Realm (osu!lazer) stay lazy: they fail with DllNotFoundException only if used. -->
  <!-- PlatformInfo.IsSwitch: embedded in the binary as AppContext data. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Waddamburo.Switch" Value="true" Trim="true" />
  </ItemGroup>
  <ItemGroup>
    <DirectPInvoke Include="SDL3" />
    <DirectPInvoke Include="bgfx" />
    <DirectPInvoke Include="waddamburo_media" />
    <DirectPInvoke Include="waddamburo_text" />
    <DirectPInvoke Include="waddamburo_texture" />
    <DirectPInvoke Include="e_sqlite3" />
  </ItemGroup>
</Project>
