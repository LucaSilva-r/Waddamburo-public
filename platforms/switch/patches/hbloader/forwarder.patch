-        memcpy(g_nextArgv,    DEFAULT_NRO, sizeof(DEFAULT_NRO));
+        if (g_forwarderStarted || g_forwarderTarget[32] == '\0')
+            svcExitProcess();
+        for (size_t i = 0; i < sizeof g_nextNroPath - 1 && g_forwarderTarget[32 + i]; i++)
